# Mabojolu AI environment configuration
#
# Copy this file to `.env.local` and fill in what you need:
#   cp .env.example .env.local
#
# `.env.local` is git-ignored. Never commit real credentials.
# Every value here is server-only. Do not prefix any of these with
# NEXT_PUBLIC_, which would expose them to the browser.


# ----------------------------------------------------------------------------
# AI provider
# ----------------------------------------------------------------------------

# Which provider serves chat requests.
#   mock       Local deterministic responder. No credential needed. Default.
#   anthropic  Live Claude models. Requires ANTHROPIC_API_KEY below.
#
# Leave this as `mock` until you are ready to test against a live model, so
# development and tests cost nothing.
AI_PROVIDER=mock

# Anthropic API key. Required only when AI_PROVIDER=anthropic.
#
# Where to get it:
#   1. Sign in at https://platform.claude.com
#   2. Open Settings, then API keys
#   3. Create a key and copy it once, since it is shown only at creation
#
# Note: a Claude.ai or Claude Code subscription does NOT include API access.
# The API is billed separately and needs its own key from the link above.
# ANTHROPIC_API_KEY=sk-ant-...

# Override the default model. Must be an id from src/lib/ai/models.ts.
# Options: mabojolu-core, mabojolu-swift (anthropic) or mabojolu-mock (mock).
# Defaults to the first enabled model for the configured provider.
# MABOJOLU_DEFAULT_MODEL=mabojolu-core


# ----------------------------------------------------------------------------
# Generation limits
# ----------------------------------------------------------------------------

# Maximum tokens generated per response. Clamped to the model's own ceiling.
# On current Claude models this budget covers reasoning plus visible text, so
# leaving it too low can truncate an answer mid-thought.
MABOJOLU_MAX_OUTPUT_TOKENS=8192

# Provider request timeout, in milliseconds.
MABOJOLU_REQUEST_TIMEOUT_MS=120000

# Token budget for reconstructed conversation context. Older turns are dropped
# when a conversation exceeds this, so raising it costs money and lowering it
# shortens the model's memory of the conversation.
MABOJOLU_CONTEXT_TOKEN_BUDGET=120000


# ----------------------------------------------------------------------------
# Request limits and abuse controls
# ----------------------------------------------------------------------------

# Maximum characters in a single user message.
MABOJOLU_MAX_MESSAGE_CHARS=32000

# Maximum messages accepted in one conversation request.
MABOJOLU_MAX_CONVERSATION_MESSAGES=400

# Requests allowed per window, per identity.
#
# Important limitation: the current limiter is in-memory and per instance. On a
# multi-instance deployment each instance keeps its own window, so the effective
# global limit is this value multiplied by the instance count. Replace the store
# in src/lib/security/rate-limit.ts with a shared backend before relying on this
# as a hard global limit.
MABOJOLU_RATE_LIMIT_MAX=30
MABOJOLU_RATE_LIMIT_WINDOW_MS=60000


# ----------------------------------------------------------------------------
# Persistence and authentication
# ----------------------------------------------------------------------------

# Where conversations are stored.
#   local     JSON file under .mabojolu-data. No credentials. Development only.
#   supabase  Postgres with row-level security. Requires the keys below.
#
# Production refuses to start with `local`: it is a single file with no
# row-level security and does not survive an ephemeral filesystem.
PERSISTENCE=local

# How users authenticate.
#   dev       Two fixed local identities, so account boundaries and per-user
#             limits are testable without an auth provider. Refuses to run in
#             production, because it trusts a cookie with no verification.
#   supabase  Real email magic-link authentication.
AUTH_MODE=dev

# --- Supabase credentials, required when PERSISTENCE or AUTH_MODE is supabase ---
#
# Where to get these: Supabase dashboard, then Project Settings, then API.
# Full walkthrough in docs/SUPABASE.md.

# Safe to expose to the browser.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Safe to expose. Protected by row-level security, which is why the policies in
# supabase/migrations/0002 being correct is load-bearing.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# NEVER expose this. It bypasses row-level security entirely, so a copy in the
# browser makes every user's conversations readable by anyone. Server-side only,
# and only for operations that genuinely cannot run as the user.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...


# ----------------------------------------------------------------------------
# Usage limits and cost control
# ----------------------------------------------------------------------------

# Messages one user may send per day.
MABOJOLU_DAILY_MESSAGE_LIMIT=200

# Generations one user may have running at once.
MABOJOLU_MAX_CONCURRENT_GENERATIONS=2

# Daily spend ceiling in USD. Zero disables the check.
#
# Set a real value before opening access to anyone else. It is the only control
# that stops unexpected spend independently of message counts, since a few very
# large requests can cost more than many small ones.
MABOJOLU_DAILY_COST_LIMIT_USD=0

# Serves a maintenance notice instead of chat. The fastest way to stop
# generation without taking the whole site down.
MABOJOLU_MAINTENANCE_MODE=false


# ----------------------------------------------------------------------------
# Attachments
# ----------------------------------------------------------------------------

# Are uploads enabled?
#
# Off by default. Validation, storage, isolation, and quotas are implemented and
# tested, but enabling broad upload access should follow verification of the
# storage controls against a real project rather than happening silently.
#
# Note: even when enabled, Mabojolu does not read uploaded files. Document
# processing is not implemented, so an attachment reaches `uploaded` and never
# `ready`, and the assistant will say it cannot read the contents.
MABOJOLU_ATTACHMENTS_ENABLED=false

# Attachments one user may hold.
MABOJOLU_MAX_ATTACHMENTS_PER_USER=20

# Largest accepted attachment, in bytes. Default 10 MB.
MABOJOLU_MAX_ATTACHMENT_BYTES=10485760
