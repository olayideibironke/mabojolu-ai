# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# Ignore every real env file, since these hold credentials.
.env*
# The documented template carries no secrets and must be committed, so
# contributors know which variables exist and where to obtain each value.
!.env.example

# local development database
# Written by the local persistence adapter. Contains conversation content, so it
# must never be committed.
/.mabojolu-data

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
